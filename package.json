{
  "name": "typescript-for-testers",
  "version": "1.0.0",
  "description": "",
  "main": "dist/example.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/example.js",
    "dev": "tsx src/example.ts",
    "menu": "tsx scripts/menu.ts",
    "watch": "tsc --watch",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "update:deps": "ncu -u && npm install",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@clack/prompts": "^1.8.1",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.6.6",
    "npm-check-updates": "^23.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild": true
  }
}
